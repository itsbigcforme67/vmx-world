+                        USB_error("HUB [%s] port %d: status change failed\n", hub->pos_id, port);
                 }
             }
             hub->sc_bitmap = 0;
             /* re-submit interrupt-in transfer */
-            if (ret == 0)
             {
                 utr = hub->utr;
                 utr->xfer_len = 0;
