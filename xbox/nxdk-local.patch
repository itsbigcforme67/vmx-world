diff --git a/src_core/hub.c b/src_core/hub.c
index 9b4a190..159e7c8 100644
--- a/src_core/hub.c
+++ b/src_core/hub.c
@@ -24,8 +24,8 @@
 /// @cond HIDDEN_SYMBOLS
 
 
